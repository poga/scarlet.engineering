---
pagination:
  data: presskits.indexes
  size: 1
  alias: press
layout: press-base.njk
permalink: "{{ press.url }}"
eleventyComputed:
  title: "{{ press.t.pressKits | safe }}"
---
{%- set t = press.t %}
<div class="eyebrow">Scarlet Engineering</div>
<h1>{{ t.pressKits }}</h1>

<div class="asset-grid kit-grid">
    {%- for kit in press.kits %}
    <a href="{{ kit.url }}">
        {%- if kit.keyArt %}<img src="{{ kit.assetBase }}/{{ kit.keyArt }}" alt="{{ kit.title }}">{% endif %}
        <div class="kit-card">
            <strong>{{ kit.title }}</strong>
            {%- if kit.tagline %}<div class="kit-tagline">{{ kit.tagline }}</div>{% endif %}
        </div>
    </a>
    {%- endfor %}
    {%- if press.kits.length == 0 %}<p class="hint">{{ t.noKits }}</p>{% endif %}
</div>

{%- set contactLine = t.contactLine.split("{email}") %}
<p class="press-footer">{{ contactLine[0] }}<a href="mailto:press@scarlet.engineering">press@scarlet.engineering</a>{{ contactLine[1] }}</p>
