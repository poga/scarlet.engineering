---
pagination:
  data: presskits.pages
  size: 1
  alias: press
layout: press-base.njk
permalink: "{{ press.url }}"
eleventyComputed:
  title: "{{ press.t.pageTitle | fill({ title: press.kit.title }) | safe }}"
  description: "{{ (press.kit.tagline or press.kit.descriptionShort) | safe }}"
  image: "{{ press.kit.keyArt and ('https://scarlet.engineering' + press.assetBase + '/' + press.kit.keyArt) or 'https://scarlet.engineering/logo-v2.png' }}"
---
{%- set kit = press.kit %}
{%- set t = press.t %}
{%- set base = press.assetBase %}
<header>
    {%- if kit.developer %}<div class="eyebrow">{{ t.eyebrow | fill({ developer: kit.developer }) }}</div>{% endif %}
    <h1>{{ kit.title }}</h1>
    {%- if kit.tagline %}<p class="tagline">{{ kit.tagline }}</p>{% endif %}
    {%- if kit.keyArt %}<img class="hero-art" src="{{ base }}/{{ kit.keyArt }}" alt="{{ kit.captions[kit.keyArt] or (t.keyArtAlt | fill({ title: kit.title })) }}">{% endif %}
    <div class="actions">
        <a class="btn btn-primary" href="{{ base }}.zip" download>&#8595; {{ t.downloadAll }}</a>
        {%- if kit.website %}<a class="btn" href="{{ kit.website }}" target="_blank" rel="noopener">{{ t.officialSite }}</a>{% endif %}
        {%- for link in kit.buyLinks %}<a class="btn" href="{{ link.url }}" target="_blank" rel="noopener">{{ link.label }}</a>{% endfor %}
    </div>
</header>

{%- if press.facts.length %}
<section class="section">
    <h2>{{ t.factSheet }}</h2>
    <dl class="fact-sheet">
        {%- for fact in press.facts %}
        <dt>{{ t[fact.key] }}</dt><dd>{% if fact.href %}<a href="{{ fact.href }}"{% if fact.external %} target="_blank" rel="noopener"{% endif %}>{{ fact.value }}</a>{% else %}{{ fact.value }}{% endif %}</dd>
        {%- endfor %}
    </dl>
</section>
{%- endif %}

{%- if kit.descriptionShort or kit.descriptionLong %}
<section class="section">
    <h2>{{ t.description }}</h2>
    {%- if kit.descriptionShort %}
    <div class="copy-block">
        <button class="copy-btn" data-copy-target="#desc-short" data-copied-label="{{ t.copied }}">{{ t.copy }}</button>
        <div class="copy-body" id="desc-short"><p>{{ kit.descriptionShort }}</p></div>
    </div>
    {%- endif %}
    {%- if kit.descriptionLong %}
    <div class="copy-block">
        <button class="copy-btn" data-copy-target="#desc-long" data-copied-label="{{ t.copied }}">{{ t.copy }}</button>
        <div class="copy-body" id="desc-long">{% for para in kit.descriptionLong %}<p>{{ para }}</p>{% endfor %}</div>
    </div>
    {%- endif %}
</section>
{%- endif %}

{%- for block in kit.copy %}
<section class="section">
    <h2>{{ block.title }}</h2>
    <div class="copy-block">
        <button class="copy-btn" data-copy-target="#copy-{{ loop.index }}" data-copied-label="{{ t.copied }}">{{ t.copy }}</button>
        <div class="copy-body" id="copy-{{ loop.index }}">{% for para in block.paragraphs %}{% if para.heading %}<h3>{{ para.heading }}</h3>{% else %}<p>{{ para }}</p>{% endif %}{% endfor %}</div>
    </div>
</section>
{%- endfor %}

{%- if kit.features %}
<section class="section">
    <h2>{{ t.features }}</h2>
    <ul class="feature-list">{% for f in kit.features %}<li>{{ f }}</li>{% endfor %}</ul>
</section>
{%- endif %}

{%- if kit.trailer and (kit.trailer.youtube or kit.trailer.embedUrl or kit.trailer.file) %}
{%- set trailerTitle = t.trailerTitle | fill({ title: kit.title }) %}
<section class="section">
    <h2>{{ t.trailer }}</h2>
    <div class="video-wrap">
        {%- if kit.trailer.youtube %}<iframe src="https://www.youtube.com/embed/{{ kit.trailer.youtube }}?hl={{ press.locale }}&amp;cc_lang_pref={{ press.locale }}" title="{{ trailerTitle }}" allowfullscreen></iframe>
        {%- elif kit.trailer.embedUrl %}<iframe src="{{ kit.trailer.embedUrl }}" title="{{ trailerTitle }}" allowfullscreen></iframe>
        {%- elif kit.trailer.file %}<video controls preload="metadata" src="{{ base }}/{{ kit.trailer.file }}"{% if kit.trailer.cover %} poster="{{ base }}/{{ kit.trailer.cover }}"{% endif %}></video>{% endif %}
    </div>
    <div class="actions">
        {%- if kit.trailer.download %}<a class="btn" href="{{ kit.trailer.download }}" download>&#8595; {{ t.downloadTrailer }}</a>
        {%- elif kit.trailer.file %}<a class="btn" href="{{ base }}/{{ kit.trailer.file }}" download>&#8595; {{ t.downloadTrailer }}</a>{% endif %}
        {%- if kit.trailer.cover %}<a class="btn" href="{{ base }}/{{ kit.trailer.cover }}" download>&#8595; {{ t.downloadCover }}</a>{% endif %}
    </div>
</section>
{%- endif %}

{%- if kit.screenshots %}
<section class="section">
    <h2>{{ t.screenshots }}</h2>
    <p class="hint">{{ t.screenshotsHint }}</p>
    <div class="asset-grid">
        {%- for shot in kit.screenshots %}
        <a href="{{ base }}/{{ shot }}" target="_blank" rel="noopener"><img src="{{ base }}/{{ shot }}" alt="{{ kit.captions[shot] or (t.screenshotAlt | fill({ title: kit.title })) }}" loading="lazy"></a>
        {%- endfor %}
    </div>
</section>
{%- endif %}

{%- if kit.videos %}
<section class="section">
    <h2>{{ t.videoClips }}</h2>
    <p class="hint">{{ t.videoClipsHint }}</p>
    <div class="clip-grid">
        {%- for v in kit.videos %}
        <figure>
            <video controls preload="metadata" src="{{ base }}/{{ v.file }}"></video>
            <figcaption>{{ kit.captions[v.file] or v.file }} &middot; <a href="{{ base }}/{{ v.file }}" download>.mov</a>{% if v.gif %} &middot; <a href="{{ base }}/{{ v.gif }}" download>.gif</a>{% endif %}</figcaption>
        </figure>
        {%- endfor %}
    </div>
</section>
{%- endif %}

{%- set studioLogo = "/press/assets/studio/scarlet-engineering-logo.png" %}
<section class="section">
    <h2>{{ t.logos }}</h2>
    <div class="logo-grid">
        {%- for logo in kit.logos %}
        <a href="{{ base }}/{{ logo }}" target="_blank" rel="noopener"><img src="{{ base }}/{{ logo }}" alt="{{ kit.captions[logo] or (t.logoAlt | fill({ title: kit.title })) }}"></a>
        {%- endfor %}
        <a href="{{ studioLogo }}" target="_blank" rel="noopener"><img src="{{ studioLogo }}" alt="{{ t.studioLogoAlt }}"></a>
    </div>
</section>

{%- if kit.awards %}
<section class="section">
    <h2>{{ t.awards }}</h2>
    <ul class="award-list">{% for a in kit.awards %}<li>{{ a.title }}{% if a.source %}{{ t.partSeparator }}{{ a.source }}{% endif %}{% if a.year %}{{ t.partSeparator }}{{ a.year }}{% endif %}</li>{% endfor %}</ul>
</section>
{%- endif %}

{%- if kit.quotes %}
<section class="section">
    <h2>{{ t.quotes }}</h2>
    {%- for q in kit.quotes %}
    <blockquote class="quote">
        <p>{{ t.quote | fill({ text: q.text }) }}</p>
        <cite>{{ q.author }}{% if q.outlet %}{{ t.partSeparator }}{% if q.url %}<a href="{{ q.url }}" target="_blank" rel="noopener">{{ q.outlet }}</a>{% else %}{{ q.outlet }}{% endif %}{% endif %}</cite>
    </blockquote>
    {%- endfor %}
</section>
{%- endif %}

{%- if kit.additionalLinks %}
<section class="section">
    <h2>{{ t.additionalLinks }}</h2>
    <ul>{% for link in kit.additionalLinks %}<li><a href="{{ link.url }}" target="_blank" rel="noopener">{{ link.label }}</a>{% if link.note %}{{ t.noteSeparator }}{{ link.note }}{% endif %}</li>{% endfor %}</ul>
</section>
{%- endif %}

{%- if kit.about %}
<section class="section">
    <h2>{{ t.about | fill({ name: kit.developer or t.theStudio }) }}</h2>
    {%- for para in kit.about %}<p>{{ para }}</p>{% endfor %}
</section>
{%- endif %}

{%- if kit.credits %}
<section class="section">
    <h2>{{ t.credits }}</h2>
    <dl class="fact-sheet">{% for c in kit.credits %}<dt>{{ c.role }}</dt><dd>{{ c.name }}</dd>{% endfor %}</dl>
</section>
{%- endif %}

<section class="section">
    <h2>{{ t.contact }}</h2>
    <dl class="fact-sheet">
        {%- if kit.pressContact %}<dt>{{ t.contactPress }}</dt><dd><a href="mailto:{{ kit.pressContact }}">{{ kit.pressContact }}</a></dd>{% endif %}
        {%- for label, url in kit.social %}{% if url %}<dt>{{ label }}</dt><dd><a href="{{ url }}" target="_blank" rel="noopener">{{ url }}</a></dd>{% endif %}{% endfor %}
    </dl>
</section>

{%- if kit.monetizationNote %}
<p class="press-footer">{{ kit.monetizationNote }}</p>
{%- endif %}
